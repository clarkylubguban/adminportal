VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_USE_SUPABASE_DATA=true
VITE_ADMIN_ACCESS_CODE=
VITE_ENABLE_INBOX=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_INVITE_REDIRECT_URL=https://admin.trryapparel.com/set-password

# Task automation / n8n foundation.
# Server-only. Keep disabled by default and never expose real secret values here.
ENABLE_AUTO_PLAN_TODAY=false
N8N_TASK_DRAFTS_SECRET=replace-with-server-only-hmac-secret-at-least-32-characters
N8N_TASK_DRAFTS_MAX_TASKS=3
N8N_TASK_DRAFTS_MAX_PAYLOAD_BYTES=131072
N8N_TASK_DRAFTS_MAX_TITLE_LENGTH=200
N8N_TASK_DRAFTS_MAX_BRIEF_LENGTH=10000
N8N_AUTO_PLAN_TODAY_URL=https://example.invalid/trry-auto-plan-webhook
N8N_AUTO_PLAN_TODAY_WORKFLOW=TRRY Auto Plan Today
N8N_AUTO_PLAN_TODAY_TOKEN=replace-with-server-only-dispatch-token
AUTO_PLAN_TODAY_TIMEOUT_MS=5000
AUTO_PLAN_TODAY_MAX_TASKS=3

# Browser-visible feature flag. Keep disabled by default.
VITE_ENABLE_AUTO_PLAN_TODAY=false

# Meta / Facebook Messenger receive-only integration.
# SERVER ONLY. Never prefix these with VITE_.

META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_MAX_PAYLOAD_BYTES=1048576
META_GRAPH_API_VERSION=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_SEND_TIMEOUT_MS=5000
